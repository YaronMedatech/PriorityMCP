# ---------------------------------------------------------------------------
# Priority OData connection
# ---------------------------------------------------------------------------
# Base URL of the company, INCLUDING the company name. No trailing slash needed.
#   https://<host>/odata/Priority/<tabula.ini>,<lang>/<company>
PRIORITY_ODATA_URL=https://your-host.example.com/odata/Priority/tabula.ini,1/yourcompany

# Authentication -- supply EITHER a PAT token OR a username + password.
# A PAT is sent as basic auth with the literal string "PAT" as the password.
PRIORITY_API_TOKEN=
PRIORITY_USER=
PRIORITY_PASS=

# TLS. Most on-prem Priority servers use a self-signed certificate.
#   PRIORITY_CA_BUNDLE  -- preferred: keep verifying, trust their certificate.
#   PRIORITY_VERIFY_SSL -- set to 0 to stop verifying entirely. Acceptable only
#                          on a trusted internal network; gives up MITM protection.
PRIORITY_VERIFY_SSL=1
PRIORITY_CA_BUNDLE=

# Overall budget for one Priority query, in milliseconds, spanning every retry.
# Keep it below your MCP client's request deadline (commonly 60s): if Priority is
# allowed to run longer than the client waits, the client times out first and you
# get a generic error instead of this server's explanation.
PRIORITY_TIMEOUT_MS=45000

# Ceiling on requests ONE SESSION may send Priority in a rolling minute. Every
# other limit here bounds a single call (aggregate's maxRows, query's 500 rows,
# describe_screen's metadata budget); this one bounds the calls, because the
# expensive tools are expensive by paging -- one aggregate over 50,000 rows is
# hundreds of sequential requests. It exists to stop a model in a retry loop from
# hammering a production ERP, so it is set well above normal use. Set 0 to lift it.
#
# Per session, not global: over HTTP each session gets its own budget, and in
# stdio each client is its own process. It does not bound several sessions
# together. Going over it fails the call outright rather than waiting past the
# deadline -- a limiter that sleeps past it would report as a Priority timeout.
PRIORITY_MAX_REQUESTS_PER_MIN=240

# ---------------------------------------------------------------------------
# Web SDK channel -- only needed to RUN programs and reports
# ---------------------------------------------------------------------------
# OData cannot run a Priority program at all, so that goes over the Web SDK,
# which is a separate channel with separate rules:
#   - It needs a REAL Priority user. A PAT authenticates OData and is rejected
#     here, so PRIORITY_USER / PRIORITY_PASS must be set even if OData uses a token.
#   - Its URL is the HOST ROOT (https://your-host/), NOT the OData path.
#
# Both of the settings below are derived from PRIORITY_ODATA_URL automatically,
# so leave them blank unless your installation genuinely differs.
PRIORITY_HOST_URL=
PRIORITY_COMPANY=
PRIORITY_TABULAINI=

# Catalog of programs this server may run. Priority offers no way to enumerate
# them (APPS/APP answer 404), so this file is the discovery surface: a program
# that is not listed is invisible to the model and will not be run.
PRIORITY_PROGRAMS_FILE=programs.json

# ---------------------------------------------------------------------------
# Tool exposure
# ---------------------------------------------------------------------------
# get_sales is the curated sales shortcut. It is HIDDEN by default so the generic
# discovery tools get exercised instead -- with it available the model reaches for
# it and never touches search_screens/describe_screen/query. Set to 1 to expose it.
PRIORITY_ENABLE_GET_SALES=0

# Read-only mode. Set to 1 and run_program is not registered at all, which leaves
# this server with no way to change anything in Priority: OData here is only ever
# read, so run_program is the single tool that can act.
#
# It takes away ONLY that. The discovery and read tools are never gated -- without
# search_screens and describe_screen a model cannot learn a screen name and falls
# back to inferring one from its English code, which is the mistake this server
# was built to stop (see "Why discovery rather than a method per domain").
#
# list_programs stays, so the catalogue can still be read, and says that running
# is disabled. The server's own instructions to the model change too, rather than
# only the registration: a model told it has a way to act keeps looking for it.
PRIORITY_READ_ONLY=0

# ---------------------------------------------------------------------------
# Claude (used by the chat clients only -- the MCP server never calls Claude)
# ---------------------------------------------------------------------------
# Optional: the SDK also picks up an `ant auth login` profile automatically.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Network access (npm run server:http) -- only needed to serve OTHER machines
# ---------------------------------------------------------------------------
# The stdio server (npm run server) needs none of this. These apply to the HTTP
# transport, which listens on the LAN so Claude on another machine can use the
# tools.
#
# MCP_AUTH_TOKEN is REQUIRED whenever the listener is not loopback-only, and the
# server refuses to start without it rather than warning. This process holds
# Priority credentials and every tool reads live ERP data, so an unauthenticated
# port is an open database. Minimum 16 characters; generate one with:
#   powershell -c "[guid]::NewGuid().ToString() + [guid]::NewGuid().ToString('N').Substring(0,8)"
MCP_AUTH_TOKEN=

# Defaults: 3401 on 0.0.0.0. Set MCP_HTTP_HOST=127.0.0.1 to bind loopback only
# (the token then becomes optional, e.g. when tunnelling over SSH instead).
MCP_HTTP_PORT=3401
MCP_HTTP_HOST=0.0.0.0

# How long a session may sit idle before the server drops it, in ms (default 30
# minutes). This is not optional housekeeping: an MCP client's close() sends
# NOTHING on the wire -- only an explicit terminateSession() does -- so a client
# that crashes or drops off the network would otherwise leave its session, and the
# server object behind it, alive forever.
MCP_SESSION_IDLE_MS=1800000

# ---------------------------------------------------------------------------
# Natural-language support files
# ---------------------------------------------------------------------------
# Business term -> screen mapping, and worked examples. Both are optional and
# both degrade quietly if absent, but the glossary is the single highest-value
# input to natural-language accuracy: Priority's screen titles are Priority's
# wording, not the words people actually use.
PRIORITY_GLOSSARY_FILE=glossary.json
PRIORITY_EXAMPLES_FILE=examples.json

# Per-caller Priority identities. Without it, every caller shares the single
# identity below and sees everything it can see. See users.example.json.
MCP_USERS_FILE=users.json

# ---------------------------------------------------------------------------
# TLS — encrypts the channel, and is REQUIRED for caller-supplied credentials
# ---------------------------------------------------------------------------
# Generate with:  powershell -ExecutionPolicy Bypass -File scripts/make-cert.ps1
# It prints these two lines filled in. Setting MCP_TLS_PFX switches the listener
# to HTTPS; a certificate configured but unreadable REFUSES to start rather than
# silently serving plaintext.
MCP_TLS_PFX=
MCP_TLS_PFX_PASSWORD=
# PEM alternative, if you already have a certificate from elsewhere.
MCP_TLS_CERT=
MCP_TLS_KEY=

# With TLS on, a caller may present its OWN Priority identity in headers set in
# its MCP config -- X-Priority-User + X-Priority-Pass, or X-Priority-Token for a
# PAT. Headers, never tool arguments: an argument would be chosen by the model and
# would land in the conversation and the logs. Over plain HTTP these headers are
# refused with a 400.
