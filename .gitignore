node_modules/
.env
*.pem
*.pfx
*.log
# Hashed per installation since the cache key became the installation URL --
# the bare name only matched the pre-hash file and let 1MB copies of a
# customer's screen list through.
.dictionary-cache*.json
formtree-*.txt
remote-mcp-config.json
users.json
certs/

# Generated by the test scripts: real rows and the full tool text, neither of
# which belongs in history.
tools-dump.txt
unit-*.json
service/*.exe
service/logs/
client-kit/

# Written by scripts/bootstrap-server.ps1: records that this machine already got
# its own bearer token, so a re-run does not rotate it and break the client kits.
.bootstrap-token-provisioned
